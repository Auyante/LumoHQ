# ========================================================
# LUMO HQ — ENVIRONMENT CONFIGURATION EXAMPLE
# ========================================================

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Sessions (HMAC-SHA256 / PBKDF2)
# Required in production, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Team seed passwords (optional; if empty, random ones are generated and printed once)
ADMIN_CARLOS_PASSWORD=
ADMIN_LUIS_PASSWORD=
SALES_BARBARA_PASSWORD=

# Stripe Payment Gateway (Texas Sales Tax & Subscriptions)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# SQLite / Prisma Database
DATABASE_URL=file:./dev.db


# Security (Phase 2)
# Number of reverse proxies you control in front of the app (0 on Vercel). Used to read the real client IP.
TRUSTED_PROXY_HOPS=0
# Comma-separated IPs that are never auto-blocked (e.g. the office). Leave empty if unsure.
SECURITY_ALLOWLIST_IPS=
# Development only: accept unsigned test webhooks with the header x-lumo-test-webhook: true. Ignored in production.
ALLOW_TEST_WEBHOOKS=
